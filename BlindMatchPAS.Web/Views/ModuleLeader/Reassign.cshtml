@{
    ViewData["Title"] = "Reassign Match";
    var match = ViewBag.Match as BlindMatchPAS.Core.Entities.Match;
    var supervisors = ViewBag.Supervisors as IEnumerable<BlindMatchPAS.Core.Entities.ApplicationUser>;
}

<div class="pas-page-header">
    <h2>Reassign Match</h2>
    <p>Select a new supervisor for this project</p>
</div>

@if (match != null)
{
    <div class="alert-pas-info mb-4" style="max-width:540px;">
        <div style="display:flex;flex-direction:column;gap:0.3rem;">
            <div><span style="font-weight:600;color:var(--pas-blue);">Project:</span> @match.Project?.Title</div>
            <div><span style="font-weight:600;color:var(--pas-blue);">Research Area:</span> @match.Project?.ResearchArea?.Name</div>
        </div>
    </div>
}

<div class="pas-card" style="max-width:520px;">
    <form asp-action="Reassign" method="post">
        <input type="hidden" name="matchId" value="@match?.Id" />

        <div class="mb-4">
            <label class="form-label">Select New Supervisor</label>
            <select name="newSupervisorId" class="form-control form-select">
                @if (supervisors != null)
                {
                    foreach (var supervisor in supervisors)
                    {
                        <option value="@supervisor.Id">@supervisor.FullName</option>
                    }
                }
            </select>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn-pas-orange">Confirm Reassignment</button>
            <a asp-action="Dashboard" class="btn-pas-secondary">Cancel</a>
        </div>
    </form>
</div>
